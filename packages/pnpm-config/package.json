{
  "name": "@syncbridge/pnpm-config",
  "version": "1.0.0",
  "description": "pnpm's config dependency for SyncBridge module repositories: SyncBridge's modules from the registry's npm mirror",
  "author": "Panates Inc",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncbridge-io/node-sdk.git",
    "directory": "packages/pnpm-config"
  },
  "keywords": [
    "syncbridge",
    "pnpm",
    "pnpmfile"
  ],
  "scripts": {
    "test": "mocha",
    "cover": "c8 mocha",
    "prepublishOnly": "node -e \"console.error('This package publishes from build/, never from the source tree. Run: rman publish'); process.exit(1)\""
  },
  "devDependencies": {
    "expect": "^30.5.2"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/syncbridge-io/node-sdk/tree/main/packages/pnpm-config#readme",
  "bugs": {
    "url": "https://github.com/syncbridge-io/node-sdk/issues"
  }
}
