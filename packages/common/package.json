{
  "name": "@syncbridge/common",
  "version": "2.17.0",
  "description": "SyncBridge Common utilities",
  "author": "Panates Inc",
  "license": "MIT",
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncbridge-io/node-sdk.git",
    "directory": "packages/common"
  },
  "scripts": {
    "test": "mocha",
    "cover": "c8 mocha",
    "prepublishOnly": "node -e \"console.error('This package publishes from build/, never from the source tree. Run: rman publish'); process.exit(1)\""
  },
  "dependencies": {
    "@jsopen/objects": "^2.3.4",
    "caller-callsite": "^6.0.0",
    "fast-deep-equal": "^3.1.3",
    "node-events-async": "^1.5.2",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "ts-gems": "^4.0.4",
    "valgen": "^7.0.7"
  },
  "peerDependencies": {
    "@opra/common": ">=1.17.1 <2"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "expect": "^30.5.2"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./web": {
      "types": "./web.d.ts",
      "default": "./web.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/syncbridge-io/node-sdk/tree/main/packages/common#readme",
  "bugs": {
    "url": "https://github.com/syncbridge-io/node-sdk/issues"
  }
