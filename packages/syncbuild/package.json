{
  "name": "@syncbridge/syncbuild",
  "version": "2.4.0",
  "description": "SyncBridge Extension Package Builder",
  "author": "Panates Inc",
  "license": "MIT",
  "private": "true",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncbridge-io/node-sdk.git",
    "directory": "packages/syncbuild"
  },
  "scripts": {
    "test": "mocha",
    "cover": "c8 mocha",
    "prepublishOnly": "node -e \"console.error('This package publishes from build/, never from the source tree. Run: rman publish'); process.exit(1)\""
  },
  "dependencies": {
    "@jsopen/objects": "^2.3.4",
    "@syncbridge/runtime": "^2.0.2",
    "adm-zip": "^0.6.1",
    "ansi-colors": "^4.1.3",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "pnpm": "^12.14.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@syncbridge/common": "^2.1.0"
  },
  "devDependencies": {
    "@jsopen/objects": "^2.3.4",
    "@types/adm-zip": "^0.5.8",
    "@types/mdast": "^4.0.4",
    "@types/semver": "^7.8.0",
    "expect": "^30.5.2",
    "sinon": "^22.1.0"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./register": {
      "types": "./register.d.ts",
      "default": "./register.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "spm": "cli.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/syncbridge-io/node-sdk/tree/main/packages/syncbuild#readme",
  "bugs": {
    "url": "https://github.com/syncbridge-io/node-sdk/issues"
  }
}
